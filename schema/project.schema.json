{
  "title": "OpenEffects project",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "$ref": "#/$defs/__schema0"
    },
    "version": {
      "$ref": "#/$defs/__schema1"
    },
    "name": {
      "$ref": "#/$defs/__schema2"
    },
    "compositions": {
      "$ref": "#/$defs/__schema3"
    }
  },
  "required": [
    "version",
    "compositions"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string"
    },
    "__schema1": {
      "type": "number",
      "const": 1
    },
    "__schema2": {
      "type": "string"
    },
    "__schema3": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema4"
      },
      "description": "The first composition is the main one"
    },
    "__schema4": {
      "type": "object",
      "properties": {
        "id": {
          "description": "Composition id",
          "$ref": "#/$defs/__schema5"
        },
        "name": {
          "type": "string"
        },
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "Seconds"
        },
        "background": {
          "description": "Default: transparent (black in video exports)",
          "$ref": "#/$defs/__schema6"
        },
        "markers": {
          "description": "Timeline markers (e.g. beats, cues) to time animation to",
          "$ref": "#/$defs/__schema7"
        },
        "layers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema8"
          },
          "description": "Rendered in order: the LAST layer is drawn on top"
        }
      },
      "required": [
        "id",
        "width",
        "height",
        "fps",
        "duration",
        "layers"
      ],
      "additionalProperties": false
    },
    "__schema5": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Unique id within the composition"
    },
    "__schema6": {
      "type": "string",
      "description": "Color: #rgb, #rrggbb, #rrggbbaa, rgb()/rgba() or a basic name"
    },
    "__schema7": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "type": "number",
            "minimum": 0,
            "description": "Seconds"
          },
          "label": {
            "type": "string"
          },
          "color": {
            "$ref": "#/$defs/__schema6"
          }
        },
        "required": [
          "t"
        ],
        "additionalProperties": false
      }
    },
    "__schema8": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "solid"
            },
            "color": {
              "description": "A color or a gradient",
              "$ref": "#/$defs/__schema64"
            },
            "size": {
              "description": "Default: composition size",
              "$ref": "#/$defs/__schema19"
            }
          },
          "required": [
            "id",
            "type",
            "color"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "rect"
            },
            "size": {
              "$ref": "#/$defs/__schema19"
            },
            "radius": {
              "$ref": "#/$defs/__schema31"
            },
            "fill": {
              "$ref": "#/$defs/__schema64"
            },
            "stroke": {
              "$ref": "#/$defs/__schema65"
            }
          },
          "required": [
            "id",
            "type",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "ellipse"
            },
            "size": {
              "$ref": "#/$defs/__schema19"
            },
            "fill": {
              "$ref": "#/$defs/__schema64"
            },
            "stroke": {
              "$ref": "#/$defs/__schema65"
            }
          },
          "required": [
            "id",
            "type",
            "size"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "path"
            },
            "d": {
              "anyOf": [
                {
                  "$ref": "#/$defs/__schema66"
                },
                {
                  "$ref": "#/$defs/__schema67"
                }
              ],
              "description": "SVG path data, in layer coordinates. Keyframe it to morph between shapes: every keyframe needs the same commands and number of points"
            },
            "fill": {
              "$ref": "#/$defs/__schema64"
            },
            "stroke": {
              "$ref": "#/$defs/__schema65"
            },
            "trim": {
              "description": "Animate end 0→100 to draw a line on",
              "$ref": "#/$defs/__schema69"
            }
          },
          "required": [
            "id",
            "type",
            "d"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string",
              "description": "Use \\n for line breaks"
            },
            "font": {
              "type": "object",
              "properties": {
                "family": {
                  "description": "Default Inter",
                  "$ref": "#/$defs/__schema70"
                },
                "weight": {
                  "description": "100-900. Default 700",
                  "$ref": "#/$defs/__schema71"
                },
                "style": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "italic"
                  ]
                },
                "size": {
                  "description": "px. Default 96",
                  "$ref": "#/$defs/__schema31"
                }
              },
              "additionalProperties": false
            },
            "fill": {
              "description": "Default white",
              "$ref": "#/$defs/__schema64"
            },
            "stroke": {
              "$ref": "#/$defs/__schema65"
            },
            "align": {
              "description": "Default center",
              "$ref": "#/$defs/__schema72"
            },
            "letterSpacing": {
              "description": "px. Default 0",
              "$ref": "#/$defs/__schema31"
            },
            "lineHeight": {
              "description": "Multiple of font size. Default 1.2",
              "$ref": "#/$defs/__schema73"
            },
            "animator": {
              "type": "object",
              "properties": {
                "by": {
                  "$ref": "#/$defs/__schema74"
                },
                "order": {
                  "$ref": "#/$defs/__schema76"
                },
                "delay": {
                  "$ref": "#/$defs/__schema78"
                },
                "stagger": {
                  "$ref": "#/$defs/__schema80"
                },
                "duration": {
                  "$ref": "#/$defs/__schema82"
                },
                "ease": {
                  "$ref": "#/$defs/__schema84"
                },
                "from": {
                  "$ref": "#/$defs/__schema85"
                }
              },
              "required": [
                "from"
              ],
              "additionalProperties": false,
              "description": "Build-in animation applied per character/word/line"
            }
          },
          "required": [
            "id",
            "type",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "image"
            },
            "src": {
              "type": "string",
              "description": "Path relative to the project folder, e.g. assets/logo.png"
            },
            "size": {
              "description": "Default: natural image size",
              "$ref": "#/$defs/__schema19"
            }
          },
          "required": [
            "id",
            "type",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "video"
            },
            "src": {
              "type": "string",
              "description": "Path relative to the project folder, e.g. assets/clip.mp4"
            },
            "size": {
              "description": "Default: the video's own size",
              "$ref": "#/$defs/__schema19"
            },
            "loop": {
              "description": "Loop the clip when it reaches its end",
              "$ref": "#/$defs/__schema94"
            },
            "trimStart": {
              "$ref": "#/$defs/__schema95"
            },
            "speed": {
              "$ref": "#/$defs/__schema97"
            },
            "volume": {
              "$ref": "#/$defs/__schema99"
            },
            "muted": {
              "$ref": "#/$defs/__schema100"
            }
          },
          "required": [
            "id",
            "type",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "audio"
            },
            "src": {
              "type": "string",
              "description": "Path relative to the project folder, e.g. assets/music.mp3"
            },
            "trimStart": {
              "$ref": "#/$defs/__schema95"
            },
            "speed": {
              "$ref": "#/$defs/__schema97"
            },
            "volume": {
              "$ref": "#/$defs/__schema99"
            },
            "muted": {
              "$ref": "#/$defs/__schema100"
            }
          },
          "required": [
            "id",
            "type",
            "src"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "null"
            }
          },
          "required": [
            "id",
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/__schema5"
            },
            "name": {
              "$ref": "#/$defs/__schema9"
            },
            "in": {
              "$ref": "#/$defs/__schema10"
            },
            "out": {
              "$ref": "#/$defs/__schema12"
            },
            "visible": {
              "$ref": "#/$defs/__schema14"
            },
            "parent": {
              "$ref": "#/$defs/__schema16"
            },
            "transform": {
              "$ref": "#/$defs/__schema18"
            },
            "effects": {
              "$ref": "#/$defs/__schema34"
            },
            "behaviors": {
              "$ref": "#/$defs/__schema37"
            },
            "blend": {
              "$ref": "#/$defs/__schema58"
            },
            "matte": {
              "$ref": "#/$defs/__schema59"
            },
            "type": {
              "type": "string",
              "const": "comp"
            },
            "comp": {
              "type": "string",
              "description": "Id of another composition to nest (precomp)"
            },
            "timeOffset": {
              "description": "Seconds. Nested time = time - in + timeOffset",
              "$ref": "#/$defs/__schema101"
            },
            "timeRemap": {
              "description": "Seconds of the nested composition to show (animatable: freeze frames, slow motion, reverse). Overrides timeOffset",
              "$ref": "#/$defs/__schema31"
            }
          },
          "required": [
            "id",
            "type",
            "comp"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema9": {
      "type": "string"
    },
    "__schema10": {
      "description": "Seconds when the layer appears. Default 0",
      "$ref": "#/$defs/__schema11"
    },
    "__schema11": {
      "type": "number",
      "minimum": 0
    },
    "__schema12": {
      "description": "Seconds when the layer disappears. Default: composition end",
      "$ref": "#/$defs/__schema13"
    },
    "__schema13": {
      "type": "number",
      "minimum": 0
    },
    "__schema14": {
      "description": "false hides the layer (it can still be used as a matte or parent)",
      "$ref": "#/$defs/__schema15"
    },
    "__schema15": {
      "type": "boolean"
    },
    "__schema16": {
      "description": "Id of a layer whose transform this layer inherits",
      "$ref": "#/$defs/__schema17"
    },
    "__schema17": {
      "type": "string"
    },
    "__schema18": {
      "type": "object",
      "properties": {
        "position": {
          "description": "Pixels in the parent's (or composition's) space. Default: composition center ([0,0] for path layers)",
          "$ref": "#/$defs/__schema19"
        },
        "anchor": {
          "description": "Offset of the layer's pivot from its content origin. Default [0,0]",
          "$ref": "#/$defs/__schema19"
        },
        "scale": {
          "description": "Percent. Default 100",
          "$ref": "#/$defs/__schema27"
        },
        "rotation": {
          "description": "Degrees, clockwise. Default 0",
          "$ref": "#/$defs/__schema31"
        },
        "opacity": {
          "description": "0-100. Default 100",
          "$ref": "#/$defs/__schema31"
        }
      },
      "additionalProperties": false
    },
    "__schema19": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema20"
        },
        {
          "type": "object",
          "properties": {
            "keyframes": {
              "minItems": 1,
              "type": "array",
              "items": {
                "$ref": "#/$defs/__schema23"
              },
              "description": "Keyframes, sorted by t"
            }
          },
          "required": [
            "keyframes"
          ],
          "additionalProperties": false
        }
      ]
    },
    "__schema20": {
      "type": "array",
      "prefixItems": [
        {
          "$ref": "#/$defs/__schema21"
        },
        {
          "$ref": "#/$defs/__schema22"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2,
      "description": "[x, y]"
    },
    "__schema21": {
      "type": "number"
    },
    "__schema22": {
      "type": "number"
    },
    "__schema23": {
      "type": "object",
      "properties": {
        "t": {
          "type": "number",
          "minimum": 0,
          "description": "Time in seconds (composition time)"
        },
        "v": {
          "$ref": "#/$defs/__schema20"
        },
        "ease": {
          "description": "Easing used from this keyframe to the next. Default easeInOut",
          "$ref": "#/$defs/__schema24"
        }
      },
      "required": [
        "t",
        "v"
      ],
      "additionalProperties": false
    },
    "__schema24": {
      "anyOf": [
        {
          "$ref": "#/$defs/__schema25"
        },
        {
          "$ref": "#/$defs/__schema26"
        }
      ],
      "description": "Named easing (e.g. easeOutCubic, easeOutBack, linear, hold) or cubic-bezier [x1, y1, x2, y2]"
    },
    "__schema25": {
      "type": "string",
      "enum": [
        "linear",
        "hold",
        "easeIn",
        "easeOut",
        "easeInOut",
        "easeInSine",
        "easeOutSine",
